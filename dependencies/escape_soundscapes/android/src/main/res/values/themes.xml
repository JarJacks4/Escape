<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opaque night-blue window behind the Compose content, no action bar, no translucency. -->
    <style name="Theme.EscapeSoundscapes" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/escape_soundscapes_night</item>
        <item name="android:colorBackground">@color/escape_soundscapes_night</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <color name="escape_soundscapes_night">#FF0B1230</color>
</resources>
