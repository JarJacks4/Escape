# Existing rules
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# ------------------------------
# Unreal / iOS specific ignores
# Ignore Unreal asset files
*.uasset
*.umap
*.pak

# Ignore intermediate / build files
Binaries/
Intermediate/
DerivedDataCache/

# Ignore iOS build products
build/
*.xcworkspace
*.xcuserdata
*.xcodeproj/project.xcworkspace
*.xcodeproj/xcuserdata/

# Ignore Swift Package Manager build
.build/
Packages/

# Ignore CocoaPods
Pods/
.dart_tool/
ios/Flutter/ephemeral/
pubspec.lock
ios/Podfile.lock
